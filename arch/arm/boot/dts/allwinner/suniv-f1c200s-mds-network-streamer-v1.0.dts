/dts-v1/;
#include "suniv-f1c100s.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "MDS Network Streamer v1.0";
	compatible = "mds,network-streamer-v1.0",
		     "allwinner,suniv-f1c200s";

	aliases {
		serial0 = &uart0;
		i2c0 = &i2c0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		led {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pio 3 7 GPIO_ACTIVE_HIGH>; /* PD7 */
			linux,default-trigger = "heartbeat";
		};
	};

	reg_vcc3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	audio_mclk: audio-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <25000000>;
	};



	// es9023: pcm5102a {
	// 	#sound-dai-cells = <0>;
	// 	compatible = "ti,pcm5102a";
	// };

	spdif_out: spdif-out {
		#sound-dai-cells = <0>;
		compatible = "linux,spdif-dit";
	};

	// sound-i2s {
	// 	compatible = "simple-audio-card";
	// 	simple-audio-card,name = "tas5756";
	// 	simple-audio-card,format = "i2s";
	// 	simple-audio-card,mclk-fs = <256>;
		
	// 	simple-audio-card,cpu {
	// 		#sound-dai-cells = <0>;
	// 		sound-dai = <&i2s0>;
	// 	};

	// 	simple-audio-card,codec {
	// 		sound-dai = <&tas5756>;
	// 	};
	// };

	// sound-i2s {
	// 	compatible = "simple-audio-card";
    //     simple-audio-card,name = "JustBoom AMP zero";
	// 	simple-audio-card,format = "i2s";
	// 	simple-audio-card,mclk-fs = <512>;
	// 	simple-audio-card,cpu {
	// 		sound-dai = <&i2s0>;
	// 	};
	// 	simple-audio-card,codec {
	// 		sound-dai = <&tas5756>;
	// 	};
	// };
	sound-spdif {
		compatible = "simple-audio-card";
		simple-audio-card,name = "On-board SPDIF";

		simple-audio-card,cpu {
			sound-dai = <&spdif>;
		};

		simple-audio-card,codec {
			sound-dai = <&spdif_out>;
		};
	};
};



&otg_sram {
	status = "okay";
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pc_pins>;
	status = "okay";
	flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "winbond,w25q128", "spi-nand";
		reg = <0>;
		spi-max-frequency = <50000000>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0 0x100000>;
			};

			partition@100000 {
				label = "fota";
				reg = <0x0100000 0x0f00000>;
			};

			partition@1000000 {
				label = "rootfs";
				reg = <0x1000000 0x3800000>;
			};

			partition@4800000 {
				label = "data";
				reg = <0x4800000 0x3800000>;
			};
		};
	};

};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pe_pins>;
	status = "okay";
	
 	// spidev@0{
    //     compatible = "rohm,dh2228fv";
    //     reg = <0>;
    //     spi-max-frequency = <40000000>;
    // };
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pe_pins>;
	status = "okay";
};


// &uart1 {
// 	pinctrl-names = "default";
// 	pinctrl-0 = <&uart1_pd_pins>;
// 	status = "okay";
// };

&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	//usb0_id_det-gpios = <&pio 5 0 GPIO_ACTIVE_HIGH>; /* PF0 */
	status = "okay";
};


&spdif {
	pinctrl-names = "default";
	pinctrl-0 = <&spdif_tx_pe_pin>;
	status = "okay";
};

&i2s0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s_pe_pins>;
	status = "disabled";
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pd_pins>;
	
	tas5756: tas5756@4d {
		#sound-dai-cells = <0>;
		compatible = "ti,tas5756";
		reg = <0x4d>;
		status = "okay";
		//clocks =<&ccu CLK_I2S>;
		//clocks = <&audio_mclk>;

		// pll-in = <3>;
		// pll-out = <6>;
	};


};
